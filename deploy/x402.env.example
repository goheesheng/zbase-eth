# Template for /srv/zbase/x402.env — the paid-API container's env.
# Separate file from /srv/zbase/.env on purpose (least privilege: no postman
# or encryption keys in this container).
#
#   scp deploy/x402.env.example ubuntu@<vps>:/srv/zbase/x402.env
#   ssh ubuntu@<vps> 'chmod 600 /srv/zbase/x402.env'

# Payment recipient (defaults to the agentic wallet if unset)
X402_RECIPIENT=

PORT=4020

# Settlement network — EXPLICIT. Default sepolia. The server picks the network
# from THIS var, not from the presence of CDP keys, so a stray key can't move
# real money. USDC address + on-chain scan chain track this automatically.
X402_NETWORK=sepolia

# Stable secret so hashed wallet log entries are consistent across restarts
# (addresses are never logged in cleartext). openssl rand -hex 16
X402_LOG_SALT=

# ============================ MAINNET ONLY ==================================
# Required ONLY when X402_NETWORK=mainnet (the server refuses to boot on
# mainnet without both). Harmless/ignored on sepolia.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# ===========================================================================
