# Template for /srv/zbase/mainnet/x402.env — MAINNET paid-API container.
# The x402 server REFUSES to boot on mainnet without CDP keys.

X402_NETWORK=mainnet
X402_RECIPIENT=
PORT=4020
X402_LOG_SALT=

# Required on mainnet (the CDP facilitator; x402.org is Sepolia-only).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
