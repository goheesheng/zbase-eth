# Template for /srv/zbase/mainnet/app.env — the MAINNET app container's env.
# scp to the box, fill REAL values there, chmod 600. NEVER commit values.
# These are REAL-MONEY values. Fill only when crossing the custody gates.
#
# Health stays "degraded" until BASE_MAINNET_* + seed key + Upstash are real —
# that is expected scaffolding state, not a bug.

NEXT_PUBLIC_NETWORK=mainnet
# Also a build arg (inlined client-side). Use a paid mainnet RPC (Alchemy/Infura).
NEXT_PUBLIC_BASE_MAINNET_RPC=
NEXT_PUBLIC_WALLETCONNECT_ID=

# ── Contract stack (from DeployMainnetPool.s.sol — Stage 2). Both the server
#    and NEXT_PUBLIC_ mirror are required; contracts.ts fails closed on blanks.
BASE_MAINNET_ENTRYPOINT=
NEXT_PUBLIC_BASE_MAINNET_ENTRYPOINT=
BASE_MAINNET_POOL=
NEXT_PUBLIC_BASE_MAINNET_POOL=
BASE_MAINNET_WITHDRAWAL_VERIFIER=
NEXT_PUBLIC_BASE_MAINNET_WITHDRAWAL_VERIFIER=
BASE_MAINNET_COMMITMENT_VERIFIER=
NEXT_PUBLIC_BASE_MAINNET_COMMITMENT_VERIFIER=
BASE_MAINNET_POOL_DEPLOY_BLOCK=
NEXT_PUBLIC_BASE_MAINNET_POOL_DEPLOY_BLOCK=
# BASE_MAINNET_USDC defaults to Circle canonical; override only if you know why.
BASE_MAINNET_RPC=
# BASE_MAINNET_WRITE_RPC=   # optional dedicated write RPC

# ── Redis: MANDATORY on mainnet (facilitator-authz throws without it). Point at
#    the mainnet cloud Upstash DB (zbase-mainnet) — NOT the local SRH bridge.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Postman: CDP sponsored signer (no hot key, no ETH on the postman).
POSTMAN_SIGNER=cdp
CDP_WALLET_SECRET=
CDP_POSTMAN_SMART_ACCOUNT=zbase-postman
# EOA break-glass only: POSTMAN_PRIVATE_KEY + ZBASE_ALLOW_MAINNET_EOA_POSTMAN=true

HYPERSYNC_TOKEN=

# ── Custody key: FRESH, mainnet-only, WRITE-ONCE. openssl rand -hex 32.
#    MUST differ from Sepolia's. Losing/rotating it orphans mainnet notes.
ZBASE_SEED_ENCRYPTION_KEY=

# openssl rand -hex 32 — mainnet-specific
CRON_SECRET=

ZBASE_DECOY_DISABLED=true
# Fees off until the deliberate fee-flip (Stage 6). The CODE reads
# ZBASE_FEE_REQUIRED (facilitator-authz.ts) — a bare FEE_REQUIRED is IGNORED,
# so at fee-flip you MUST set ZBASE_FEE_REQUIRED=true, not FEE_REQUIRED.
ZBASE_FEE_REQUIRED=false

# Base URL for the app's calls to its OWN routes (settle → /api/withdraw).
# REQUIRED on the self-hosted VPS. proxy.ts re-dispatches the request through
# Next, so request.url becomes the internal origin (localhost:3000); the
# standalone server binds 0.0.0.0 (IPv4 only) while the container resolves
# `localhost` to ::1 first (Node >=17 verbatim DNS) — so the self-fetch is
# refused and every settle path dies with an opaque "fetch failed".
# Explicit IPv4 loopback avoids DNS, TLS, and the Caddy round-trip.
# Leave UNSET on Vercel (each route is its own lambda; request.url is correct).
ZBASE_INTERNAL_BASE_URL=http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────────────────
# LAUNCH GATES — these control what zBase CLAIMS, not what it can do.
#
# The machinery (Groth16 proofs, fresh payer EOAs, the pool) works regardless of
# every flag below. What they gate is whether a response is allowed to tell a
# client their payment was PRIVATE. Setting one to `true` is an assertion of
# fact by the operator; if the fact is not true, the flag makes zBase lie to
# paying customers. Nothing downstream re-checks these.
#
# Read src/lib/facilitator-readiness.ts (ReadinessScope) for which tier each one
# shuts and why.
# ─────────────────────────────────────────────────────────────────────────────

# External contract + operations review. Blocks BOTH pilot and customer.
#
# SCOPE — record this honestly, because the flag is coarser than the truth:
# 0xbow's audit covers the VENDORED privacy pool, vendor/0xbow/** (Entrypoint,
# PrivacyPool, the Groth16 circuits). That is the code holding the money, and
# treating that audit as the external review of those contracts is defensible.
#
# It does NOT cover first-party code in the same trust path:
#   - src/app/api/withdraw/route.ts  (proof generation, server-side spend secrets)
#   - src/lib/postman-signer.ts      (relay + gas sponsorship)
#   - src/lib/forwarding-*.ts        (deposit forwarding + sweep)
# So this flag means "the money CONTRACTS are audited". It does NOT mean "zBase
# is reviewed", and it must not be quoted as such to a customer.
ZBASE_EXTERNAL_REVIEW_APPROVED=true

# Jurisdiction-specific legal clearance. Blocks BOTH pilot and customer: real
# client money through a privacy pool is exactly the case that needs clearance,
# and a disclosure in a JSON response is not a jurisdiction.
ZBASE_LEGAL_CLEARANCE_APPROVED=false

# Signed customer pull for private routing. Blocks customer only — the pilot IS
# the demand test.
#
# FOOTGUN: the code reads ZBASE_PRIVATE_ROUTE_CUSTOMER_PULL_CONFIRMED
# (facilitator-readiness.ts). The obvious shorter name
# ZBASE_CUSTOMER_PULL_CONFIRMED is IGNORED — setting it does nothing, silently,
# and the gate stays shut with no hint as to why. Same failure shape as
# ZBASE_FEE_REQUIRED above.
ZBASE_PRIVATE_ROUTE_CUSTOMER_PULL_CONFIRMED=false

# Minimum independent depositors before privacy may be CLAIMED. On mainnet this
# may only RAISE the bar: values below 30 (MAINNET_ANONYMITY_FLOOR) are clamped
# up, because `=1` was a one-line path to announcing privacy at a set of one.
# If you need to transact before the set is real, that is what PILOT mode is for
# — it permits the payment and says it is not private. Turning this dial down
# would permit the payment and say it IS private.
# ZBASE_MIN_CUSTOMER_ANONYMITY_SET=30

# ── EARLY ACCESS — there is no switch, and that is deliberate ────────────────
# zBase settles real payments on mainnet as soon as the stack is sound, for
# anyone who has deposited. No key, no allowlist, no ZBASE_PILOT_ENABLED.
#
# The reasoning (src/lib/pilot.ts): the software is production-ready; what is not
# ready is arithmetic. A privacy pool hides a withdrawal among N independent
# deposits, and while N is small an observer can link it back. No flag changes
# that, and shipping more code does not either — it changes when strangers
# deposit. So every gate we tried was withholding a CAPABILITY zBase had in order
# to manage a CLAIM it could not back. Only the second problem is real, and that
# is `customerReady` — which nobody flips by hand: it becomes true at k=30
# (MAINNET_ANONYMITY_FLOOR) on its own.
#
# What happens instead: every settle returns privacy.private:false with the live
# independent-depositor count, the SDK makes callers pass acceptNotPrivate:true,
# and the web app shows an early-product strip that self-hides at k=30.
# /supported's `supported[]` stays EMPTY so no generic x402 client routes here by
# default — open and advertised are different things.
#
# What still refuses is SAFETY, never privacy: unprotected seed keys, a broken
# stack, an unverifiable set. A disclosure can honestly say "not anonymous yet";
# it cannot say "your spend secrets are unencrypted".

# Operator plumbing bypass — skips the launch gates entirely for your own tests.
# Still discloses private:false on every settle: bypassing a gate does not create
# the property the gate was checking. Not a substitute for ZBASE_PILOT_ENABLED:
# this one ignores the safety blockers (seed encryption, legal, a broken stack)
# that the pilot deliberately still honours. Use it for your own plumbing tests,
# not to serve clients.
ZBASE_ALLOW_UNREADY_SETTLE=false
