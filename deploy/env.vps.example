# Template for /srv/zbase/.env — the app container's runtime env (Sepolia).
# scp to the box, fill in real values THERE, chmod 600. NEVER commit values.
#
#   scp deploy/env.vps.example ubuntu@<vps>:/srv/zbase/.env
#   ssh ubuntu@<vps> 'chmod 600 /srv/zbase/.env && vim /srv/zbase/.env'
#
# POLICY (docs/security/key-management.md): Sepolia values only. NEVER put on
# this box: TREASURY_PRIVATE_KEY, mainnet postman key, CDP_WALLET_SECRET,
# mainnet write RPCs. Fund-key operations stay on Vercel/laptop.

NEXT_PUBLIC_NETWORK=sepolia
# Also used as a build arg by docker-compose (inlined client-side).
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_WALLETCONNECT_ID=

# Server-side RPC (Alchemy/Infura Sepolia URL recommended over the public one)
BASE_SEPOLIA_RPC=

# SEPOLIA postman only (testnet funds). Mainnet uses the CDP signer — not here.
POSTMAN_PRIVATE_KEY=

HYPERSYNC_TOKEN=

# Must MATCH the Vercel value if this box shares Upstash state with Vercel —
# cross-deployment note decryption breaks otherwise. Most sensitive value here.
ZBASE_SEED_ENCRYPTION_KEY=

# openssl rand -hex 32 — cron auth for cron-hit.sh
CRON_SECRET=

# Optional on Sepolia; required for the crons to do real work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Flip to false only after postman decoy notes are seeded.
ZBASE_DECOY_DISABLED=true

# GIT_COMMIT_SHA is NOT set here — deploy.sh injects it per build.
