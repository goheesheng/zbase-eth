    // ─────────────────────────────────────────────────────────────────────
    // Test 10 (transfer): double-spend (nullifier replay) reverts.
    // ─────────────────────────────────────────────────────────────────────
    function test_TransferRejectsDoubleSpend() public {
        uint256 stateRoot = _seedDeposit(uint256(keccak256("dup-seed")));
        uint256 aspRoot = uint256(keccak256("dup-asp"));
        entrypoint.setLatestRoot(aspRoot);

        uint256 nullifier0 = uint256(keccak256("dup-n0"));

        // ----- First transfer (consumes nullifier0). Scoped to free locals.
        {
            uint256 commit0a = uint256(keccak256("dup-c0a"));
            uint256 commit1a = uint256(keccak256("dup-c1a"));
            UTXOPool.Proof memory p1 = _transferProof(
                nullifier0,
                uint256(keccak256("dup-n1")),
                commit0a,
                commit1a,
                stateRoot,
                aspRoot
            );
            UTXOPool.CommitmentCiphertext[2] memory cts1 = [
                _ciphertext(commit0a, "dup-a-0"),
                _ciphertext(commit1a, "dup-a-1")
            ];
            entrypoint.forwardTransfer(p1, cts1);
        }

        // ----- Replay nullifier0 with a fresh slot, using the latest root.
        {
            uint256 commit0b = uint256(keccak256("dup-c0b"));
            uint256 commit1b = uint256(keccak256("dup-c1b"));
            UTXOPool.Proof memory p2 = _transferProof(
                nullifier0, // REPLAY
                uint256(keccak256("dup-n2")),
                commit0b,
                commit1b,
                pool.currentRoot(),
                aspRoot
            );
            UTXOPool.CommitmentCiphertext[2] memory cts2 = [
                _ciphertext(commit0b, "dup-b-0"),
                _ciphertext(commit1b, "dup-b-1")
            ];

            vm.expectRevert(UTXOPool.NullifierAlreadySpent.selector);
            entrypoint.forwardTransfer(p2, cts2);
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Test 11 (transfer): drain pool USDC via spend(), then verify a
    // transfer() still succeeds — transfers are pool-internal so liquidity
    // is irrelevant (Phase 1 verification #5 in the plan).
    // ─────────────────────────────────────────────────────────────────────
    function test_TransferZeroLiquidityWorks() public {
        // A transfer is pool-internal: it must work regardless of the pool's USDC
        // balance. v1 + C4: spend() no longer pays out (payout parked), so we run
        // a spend to MOVE STATE (insert change commitments) and confirm the pool
        // balance is untouched, then confirm a subsequent transfer still inserts
        // commitments and moves no USDC. (Pre-C4 this test drained via spend; the
        // drain is gone now, but the transfer-is-internal property still holds.)
        uint256 stateRoot = _seedDeposit(uint256(keccak256("drain-seed")));
        uint256 aspRoot = uint256(keccak256("drain-asp"));
        entrypoint.setLatestRoot(aspRoot);

        uint256 poolBal = usdc.balanceOf(address(pool));
        assertGt(poolBal, 0, "pool should start with USDC");

        // ----- 1. spend() moves state, pays out NOTHING (parked) ------------
        UTXOPool.Withdrawal memory w = _withdrawal(RECIPIENT);
        uint256 ctxSpend = _expectedContext(w);
        UTXOPool.Proof memory pDrain = _proof(
            uint256(keccak256("drain-spend-n0")),
            uint256(keccak256("drain-spend-n1")),
            uint256(keccak256("drain-spend-c0")),
            uint256(keccak256("drain-spend-c1")),
            poolBal, // requested unshield — IGNORED while payout is parked
            stateRoot,
            aspRoot,
            ctxSpend
        );
        bytes[2] memory drainNotes = [bytes(hex""), bytes(hex"")];
        entrypoint.forwardSpend(w, pDrain, drainNotes);
        assertEq(usdc.balanceOf(address(pool)), poolBal, "pool balance untouched (payout parked)");

        // ----- 2. transfer() still works ------------------------------------
        // State root has moved (spend inserted 2 change commitments). Use the
        // latest root for the transfer proof.
        uint256 latestRoot = pool.currentRoot();
        uint256 commit0 = uint256(keccak256("xfer-after-drain-c0"));
        uint256 commit1 = uint256(keccak256("xfer-after-drain-c1"));
        UTXOPool.Proof memory pXfer = _transferProof(
            uint256(keccak256("xfer-after-drain-n0")),
            uint256(keccak256("xfer-after-drain-n1")),
            commit0,
            commit1,
            latestRoot,
            aspRoot
        );
        UTXOPool.CommitmentCiphertext[2] memory xferCts = [
            _ciphertext(commit0, "post-drain-0"),
            _ciphertext(commit1, "post-drain-1")
        ];

        uint256 leafCountBefore = pool.leafCount();
        entrypoint.forwardTransfer(pXfer, xferCts);

        assertEq(usdc.balanceOf(address(pool)), poolBal, "pool USDC unchanged - transfers are internal");
        assertEq(pool.leafCount(), leafCountBefore + 2, "transfer still inserts commitments");
    }

    // ─────────────────────────────────────────────────────────────────────
    // Test 12 (transfer): v1 — withdrawnAmount left the public signals, so the
    // old `TransferMustBeZeroAmount` guard is gone. A transfer performs NO USDC
    // payout regardless, so a (would-be) non-zero amount cannot move funds. This
    // test pins that v1 reality: transfer succeeds and moves no USDC. Soundly
    // forcing the private withdrawnAmount to 0 for transfers is part of the C4
    // circuit fix (docs/security/internal-audit-2026-06-11.md → C4).
    // ─────────────────────────────────────────────────────────────────────
    function test_TransferDoesNotPayOut_AmountNoLongerPublic() public {
        uint256 stateRoot = _seedDeposit(uint256(keccak256("nz-seed")));
        uint256 aspRoot = uint256(keccak256("nz-asp"));
        entrypoint.setLatestRoot(aspRoot);

        uint256 commit0 = uint256(keccak256("nz-c0"));
        uint256 commit1 = uint256(keccak256("nz-c1"));

        // `_proof`'s withdrawnAmount param is ignored in v1 (not a public signal),
        // so this is a normal transfer proof bound to the transfer context.
        UTXOPool.Proof memory p = _proof(
            uint256(keccak256("nz-n0")),
            uint256(keccak256("nz-n1")),
            commit0,
            commit1,
            1, // v1: ignored — withdrawnAmount is no longer a public signal
            stateRoot,
            aspRoot,
            pool.transferContext()
        );
        UTXOPool.CommitmentCiphertext[2] memory cts = [
            _ciphertext(commit0, "nz-0"),
            _ciphertext(commit1, "nz-1")
        ];

        uint256 poolBefore = usdc.balanceOf(address(pool));
        uint256 recipientBefore = usdc.balanceOf(RECIPIENT);

        // No revert (the v0 guard is gone) and no USDC moves (transfer is internal).
        entrypoint.forwardTransfer(p, cts);

        assertEq(usdc.balanceOf(address(pool)), poolBefore, "transfer moves no pool USDC");
        assertEq(usdc.balanceOf(RECIPIENT), recipientBefore, "transfer pays out nothing");
    }
}
