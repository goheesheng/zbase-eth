# deck needs to be served via the Next dev server. Don't track the copy.
/public/decks/

# Marketing video (Remotion scaffold). WIP — clip components not yet written.
# Kept local until the project actually builds end-to-end.
/marketing-video/

# Pitch decks (investor materials — explicit founder rule, never commit)
# decks/zbase-pitch-2026-06-02.html lives locally only. /public/decks/ build
# copy is handled above; this rule covers the canonical source tree.
/decks/

# Top-level sales/ directory — GTM strategy, outbound DM drafts, named
# prospect handles, SAN Foundation outreach context, ICP segmentation.
# Originally tracked (mistake); removed from tracking 2026-06-03 as part
# of pre-public-flip cleanup. Putting these in a public repo would (a)
# expose named X.com handles paired with our "wedge" strategy for them,
# (b) hand competitors our complete GTM playbook. STAYS LOCAL.
/sales/

# Decoy scheduler burn-address list. Tracking this file would NULLIFY the
# A.2 decoy-scheduler privacy benefit — a chain analyst who reads it can
# pre-label every decoy destination in their graph and subtract decoys
# from real flow. Removed from tracking 2026-06-03 as part of
# pre-public-flip cleanup. MUST stay local; will move to zbase-platform
# private repo as part of the OSS split.
/scripts/burn-addresses.json
.env.local.backup-*

