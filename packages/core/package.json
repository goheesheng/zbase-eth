{
  "name": "@zbase-protocol/core",
  "version": "0.5.0",
  "description": "Chain-agnostic ZK privacy core for x402 AI agent payments. Poseidon hashing, Merkle trees, Groth16 proof generation, account/secrets management. Used by @zbase-protocol/svm and @zbase-protocol/mcp.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js",
      "default": "./dist/experimental.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js",
      "default": "./dist/wallet.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "AGENTS.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.3.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@zk-kit/lean-imt": "2.2.4",
    "poseidon-lite": "^0.3.0",
    "viem": "^2.55.0"
  },
  "optionalDependencies": {
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goheesheng/zBase",
    "directory": "packages/core"
  },
  "homepage": "https://zbase.app",
  "bugs": {
    "url": "https://github.com/goheesheng/zBase/issues"
  },
  "keywords": [
    "zk",
    "zero-knowledge",
    "privacy",
    "x402",
    "agents",
    "ai-agents",
    "base",
    "solana",
    "groth16",
    "poseidon",
    "privacy-pools"
  ],
  "license": "Apache-2.0"
}
