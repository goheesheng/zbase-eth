{
  "name": "@zbase-protocol/svm",
  "version": "0.2.1",
  "description": "Solana SDK for zBase — private x402 agent payments via ZK proofs on Solana. SvmPool + SvmFacilitator with on-chain Groth16 verification via Light Protocol's groth16-solana.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "dependencies": {
    "@zbase-protocol/core": "*",
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^1.3.0",
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.14",
    "@x402/svm": "^2.22.0",
    "@x402/core": "^2.22.0",
    "bn.js": "^5.2.3",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goheesheng/zBase",
    "directory": "packages/svm/sdk"
  },
  "homepage": "https://zbase.app",
  "bugs": {
    "url": "https://github.com/goheesheng/zBase/issues"
